# ===============================================================
# Outly backend — okoljske spremenljivke
# ===============================================================
# Skopiraj v .env in izpolni. Prave vrednosti so na Renderju pod
# outly-backend → Environment. .env NIKOLI ne sme v git.
# ===============================================================

# --- Podatkovna baza ---------------------------------------------------------
# Povezovalni niz PostgreSQL. Koda vklopi SSL za vse, kar ni localhost.
DATABASE_URL=postgres://uporabnik:geslo@gostitelj:5432/outly

# --- Avtentikacija -----------------------------------------------------------
# Od 11. 9. 2026 backend lastnih žetonov NE izdaja več (Supabase Auth spodaj).
# JWT_SECRET ostane samo kot rezervna skrivnost za podpis QR kod vstopnic
# (če QR_SECRET ni nastavljen). Iz nje je izpeljan tudi Ed25519 par za QR v2 (HKDF) — nove spremenljivke ni.
# Ob zamenjavi se razveljavijo vse QR kode.
JWT_SECRET=
QR_SECRET=

# --- Supabase Auth (migracija 010) --------------------------------------------
# Edina identiteta aplikacije in spletne strani. Backend Supabasov JWT (ES256)
# preveri z javnim ključem z /auth/v1/.well-known/jwks.json — skrivnosti ni.
# Obe vrednosti sta JAVNI (isti kot v supabase-config.js na outly.si) in imata
# v kodi privzete vrednosti; nastavi ju le, če se projekt zamenja.
# service_role ključa backend NE potrebuje in ga tu NE sme biti.
SUPABASE_URL=https://zbewqcxnvrwebxonvebx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_NzgXZhG7RGs0mZMjGYtyig_XfOvepXS

# --- E-pošta (Resend) --------------------------------------------------------
# POZOR: backend aplikacije uporablja Resend, ne Brevo. Brevo pokriva
# izključno waitlist na spletni strani. To sta dva ločena ponudnika.
RESEND_API_KEY=
EMAIL_FROM=Outly <luka@outly.si>
APP_NAME=Outly
# Kam gre obvestilo o novi prošnji ustvarjalca (več naslovov z vejico).
TEAM_EMAIL=luka@outly.si,fedja@outly.si
# Kam gre mail ob novi PRIJAVI ZLORABE (POST /reports, migracija 041; Apple App Review 1.2). Naslovi z vejico.
# Prazno ali ni nastavljeno = brez maila (prijave so vseeno v admin panelu, zavihek Reports). Mail vsebuje id, vrsto in ime cilja, razlog in
# uporabnisko ime prijavitelja (ne e-naslova, ne prostega besedila prijave). Najvec PRIJAVE_MAIL_NA_URO (privzeto 10) mailov na uro na proces.
# Neobvezno: PRIJAVE_NA_DAN (50, najvec prijav enega uporabnika v 24 h), BLOKI_NAJVEC (500, blokov na uporabnika).
ADMIN_PRIJAVE_EMAIL=

# --- Slike (Cloudinary) ------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=outly

# --- Strežnik ----------------------------------------------------------------
# Render to nastavi sam. Lokalno pusti 3000.
PORT=3000

# --- Izvoz baze (GET /admin/api/export) ----------------------------------------
# Neobvezno; privzeti vrednosti sta v redu. Bralec, ki ne bere dlje kot DRAIN, je odklopljen; mirujoča transakcija
# izvoza se po IDLE_TX sama prekine (migracija ob deployu ne sme čakati za izvozom). DRAIN naj bo krajši od IDLE_TX.
EXPORT_DRAIN_TIMEOUT_MS=60000
EXPORT_IDLE_TX_MS=120000

# --- Omejevalnik poskusov (omeji() v index.js, tabela omejitve) -----------------
# Neobvezno; privzeti vrednosti sta v redu. Omejevalnik ima lasten majhen pool povezav (ne zaseda glavnega poola).
# Kljuci v bazi so HMAC(pot:meja:okno:IP), izpeljan iz QR_SECRET/JWT_SECRET (nove skrivnosti ni; zamenjava skrivnosti enkrat ponastavi meje).
# Najvec povezav omejevalnika na instanco (privzeto 2). Skupaj z glavnim poolom (10) in drugimi pooli to steje proti max_connections
# Renderjeve baze 256 MB (ob prekrivanju deploya stara + nova instanca = dvojno), zato ne dvigaj brez potrebe.
# OMEJEVALNIK_POOL_MAX=2
# Kako pogosto proces pobrise iztekle vrstice (ms). Samo za teste: krajse vrednosti.
# OMEJEVALNIK_CISCENJE_MS=120000
# Pospravljanje rezervacij mize po telefonu (migracija 032): kako pogosto (ms, privzeto 3600000 = 1 h; 0 = izklop) proces pobrise
# rezervacije dogodkov, ki so se koncali pred vec kot 24 h (ime gosta je osebni podatek). Samo za teste: krajse vrednosti.
# Prvi tek je 5 min (ali interval, ce je krajsi) + nakljucnih do 60 s po zagonu.
# REZERVACIJE_CISCENJE_MS=3600000

# --- Migracije (db/migrate.js, teče ob vsakem deployu; issue #115) ---------------
# Neobvezno; privzete vrednosti so v redu. Migracija, ki v LOCK_TIMEOUT ne dobi zaklepa tabele, se vrne nazaj in poskusi
# še PONOVITVE-krat po PREMOR; če zaklepa ni, deploy pade (Render obdrži staro različico) namesto da ustavi branja in skene.
# STATEMENT_TIMEOUT velja na stavek. KLJUCAVNICA_TIMEOUT = čakanje na migracijski advisory lock druge seje.
# Kratka meja je namenoma: čakajoči ALTER blokira nove poizvedbe po tabeli (tudi sken vstopnic).
# Čas: ms ali število s priponko ms|s|min; 0 = brez meje. Dvigni samo za en deploy in samo z razlogom.
MIGRACIJA_LOCK_TIMEOUT=2s
MIGRACIJA_STATEMENT_TIMEOUT=120s
MIGRACIJA_KLJUCAVNICA_TIMEOUT=60s
MIGRACIJA_PONOVITVE=4
MIGRACIJA_PREMOR=10s

# --- Javni predpomnilnik (GET /events, /clubs, /events/:id, /clubs/:id; issue #114) -----------------------------
# Neobvezno; privzeti vrednosti sta v redu. TTL v ms (0 = izklopljeno; najvec 60000), najvec kljucev (LRU).
# Zapis v tem procesu predpomnilnik izprazni takoj; druge instance in neposredne spremembe baze zaostanejo najvec TTL.
JAVNI_PREDPOMNILNIK_MS=3000
JAVNI_PREDPOMNILNIK_KLJUCEV=300
# Casovna meja (ms) cakanja na poizvedbo, ki jo je zacel drug zahtevek za isti kljuc; obviselo poizvedbo kljuc spusti.
JAVNI_PREDPOMNILNIK_CAKANJE_MS=8000

# --- Zmogljivost / obremenitev (issue #89; vse neobvezno, privzetki so varni) ---
# Velikost glavnega poola povezav z bazo (privzeto 10) in ločenega poola SAMO za sken vstopnic (privzeto 3).
# Skupaj ne presezi max_connections baze (Render 0,1 CPU / 256 MB: preveri pred dvigom).
# Povezav na instanco: glavni pool (10) + sken (3) + omejevalnik (2) + zdravje (1, FIKSNO, brez nastavitve) = 16;
# ob prekrivanju deploya (stara + nova instanca) do 32, plus 1 povezava migrate.js ob deployu = do 33. max_connections
# Renderjeve baze 256 MB v repu NI preverjen (preveri na Renderju pred dvigom ali novim poolom).
# `zdraviPool` je lasten pool SAMO za GET /healthz (issue #117): ob navali nakupov glavni pool ni na voljo, Render pa ne sme
# dobiti 503 in instance ponovno zagnati.
# Kdaj je pool vseeno nezdrav: /healthz vrne 503 (in Render instanco ponovno zazene) samo ob ZASTOJU glavnega poola ali skenPool:
# vse povezave izposojene IN nobena se ni vrnila dlje od tega (ms; privzeto 60000, meje 100..3600000). Preobremenitev, ob kateri
# pool krozi (povezave se vracajo), tega NE sprozi, tudi ce vrsta cakajocih ni nikoli prazna; puscanje povezav in obvisele
# transakcije ga sprozijo.
ZDRAVJE_ZASICEN_MS=
PG_POOL_MAX=
PG_SKEN_POOL_MAX=
# Koliko ms zahtevek čaka na prosto povezavo, preden odpove (privzeto 10000); za sken je rok krajši (privzeto 2500),
# da telefon ob 503 hitro preklopi na preverjanje brez povezave.
PG_CONNECT_TIMEOUT_MS=
PG_SKEN_CONNECT_TIMEOUT_MS=
# Največ hkratnih nakupnih transakcij (privzeto 4); ostali nakupi čakajo v pomnilniku največ NAKUP_CAKANJE_MS
# (privzeto 15000), nato dobijo 503 Retry-After. NAKUP_DB_TIMEOUT_MS = lock_timeout in statement_timeout nakupne
# transakcije (privzeto 10000). NAKUP_RAZPRODANO_MS = kako dolgo se razprodan dogodek zavrača brez baze (privzeto 3000, 0 = izklop).
NAKUP_VZPOREDNO=
NAKUP_CAKANJE_MS=
NAKUP_DB_TIMEOUT_MS=
NAKUP_RAZPRODANO_MS=
# Idempotentni kljuc nakupa (glava Idempotency-Key, #112): kako dolgo (ms, privzeto 10000) ponovitev, katere prvotni zahtevek
# je se v teku v istem procesu, caka na njegov rezultat; potem 409 request_in_progress + Retry-After 2. 0 = takoj 409.
IDEMPOTENCA_CAKANJE_MS=

# Dnevnik povezav (issue #139): enkrat na toliko ms vrstica `[povezave] 60 s: novih N, zahtevkov M, odprtih K, zamik zanke p99 X ms, max Y ms`
# (nove povezave, zahtevki, odprte povezave in zamik zanke dogodkov v oknu; brez IP-jev in osebnih podatkov). Okno brez prometa
# ne izpise nicesar. Privzeto 60000, najmanj 100, 0 = izklop. V Render logih: iskanje `[povezave]`.
DNEVNIK_POVEZAV_MS=

# --- Placila: Stripe Checkout + Connect Express (issue #19, placila_stripe.js) ---
# Brez STRIPE_SECRET_KEY deluje testni nacin (narocilo takoj placano, oznaka test_, nic zaracunano).
# sk_test_... = Stripe SANDBOX: klubi z dokoncanim Connect onboardingom placujejo prek Stripa (testne kartice),
#               klubi brez Stripa se vedno v testnem nacinu (demo klubi, TestFlight).
# sk_live_... = pravi denar: klub brez dokoncanega onboardinga ne prodaja (409).
# Vrednosti nastavi Martin na Renderju; agent jih ne sprejema.
STRIPE_SECRET_KEY=
# Podpis webhooka /stripe/webhook (whsec_...). Brez njega Stripe nakupi vracajo 503.
STRIPE_WEBHOOK_SECRET=
# Neobvezno: drugi endpoint za dogodke povezanih racunov (account.updated), ce je v Stripu nastavljen loceno.
STRIPE_CONNECT_WEBHOOK_SECRET=
# Kam Stripe vrne kupca in klub (privzeto https://outly.si).
APP_URL=https://outly.si
# Provizija Outlyja v odstotkih (privzeto 10).
PROVIZIJA_ODSTOTEK=10
# Samo za lokalne teste: TEST_PLACILA=true vsili testni nacin; STRIPE_API_BASE preusmeri Stripe na lazni streznik.

# --- Nakup brez racuna / gost (migracija 033, index.js »NAKUP BREZ RACUNA«) ----------------------------------
# Neobvezno; privzete vrednosti so v redu.
# Nakupov gostov na IP na uro (privzeto 10), vstopnic na gostujoce narocilo (privzeto 6).
# GOST_NAKUP_NA_URO=10
# GOST_QUANTITY_NAJVEC=6
# Gostje in pravi denar (sk_live_): privzeto IZKLOPLJENO (503), vklopi Martin po objavi pogojev/politike zasebnosti: GOST_NAKUP_LIVE=1
# GOST_NAKUP_LIVE=
# Skupna meja cakajocih (neplacanih) gostujocih vstopnic na dogodek: max(NAJMANJ, ODSTOTEK % kapacitete).
# GOST_CAKAJOCIH_NAJMANJ=10
# GOST_CAKAJOCIH_ODSTOTEK=20
# Neuspesni ogledi/preklici zetona na IP na uro (privzeto 60) in iskanja po Idempotency-Key na IP na uro (privzeto 300); stevca v pomnilniku procesa.
# GOST_NEUSPESNI_NA_URO=60
# GOST_IDEM_ISKANJ_NA_URO=300
# Mail z vstopnico: globalna dnevna meja (privzeto 300), rok za klic Resenda (ms, privzeto 10000).
# GOST_POSTA_DNEVNO=300
# GOST_POSTA_TIMEOUT_MS=10000
# Koliko dni po koncu dogodka se e-naslov PLACANEGA gostujocega narocila anonimizira (privzeto 180; PREDPOSTAVKA, odloci Martin).
# Neplacano/preklicano se anonimizira po 24 h. Cistilec tece po urniku rezervacij (REZERVACIJE_CISCENJE_MS).
# GOST_HRAMBA_DNI=180
# Pospravljalec mailov z vstopnico (ms, privzeto 120000; 0 = izklop) in premor po 1. neuspelem poskusu (ms; naslednji so mnogokratniki: 2 min, 5 min, 15 min, 1 h, 3 h, 12 h, 24 h).
# GOST_POSTA_PONOVI_MS=120000
# GOST_POSTA_PREMOR_MS=120000
# GOST_POSTA_REZERVA_MS=30000   # spodnja meja premora ponovnega prevzema = GOST_POSTA_TIMEOUT_MS + to (priprava maila: QR, PDF)
# Kako pogosto /me/orders in /me/tickets znova iscejo gostujoca narocila za prevzem v racun (ms, privzeto 30000; GET /me vedno). Samo za teste: 0.
# GOST_PREVZEM_MS=30000
# Samo za teste: RESEND_BASE_URL preusmeri Resend SDK na lazni streznik.


# --- Prenos vstopnice prijatelju BREZ racuna (migracija 034, index.js »PRENOS VSTOPNICE PRIJATELJU BREZ RACUNA«) ---
# Stikalo: PRENOS_BREZ_RACUNA=vsi vklopi za VSE uporabnike; privzeto (prazno) samo vloga admin (ekipa testira v produkciji).
# Vklopi Martin na Renderju po objavi pogojev 1.2 in politike zasebnosti 2.5 (pravna presoja outly-hq pravno/2026-10-05-prenos-brez-racuna.md).
# Stikalo velja samo za posiljanje GOSTU; potrditev starosti posiljatelja (age_confirmed) pri prenosu na racun ni vezana nanj.
# PRENOS_BREZ_RACUNA=
# Meje zlorabe (mail tujemu naslovu): prenosov gostu na posiljatelja na 24 h (privzeto 10) in na isti prejemnikov e-naslov na 24 h (privzeto 10).
# Prenosi z allow_guest na posiljatelja in na (normaliziran: brez +oznake, pike pri gmail) naslov na 24 h; globalna dnevna meja prenosov gostu (ob dosegu 429 + alarm v dnevniku).
# GOST_PRENOS_NA_DAN=10
# GOST_PRENOS_NA_NASLOV=10
# GOST_PRENOS_DNEVNO=500
# Mail prejemniku uporablja iste nastavitve pospravljalca in rokov kot potrdilo gostujocega nakupa (GOST_POSTA_PONOVI_MS, GOST_POSTA_PREMOR_MS, GOST_POSTA_TIMEOUT_MS);
# hramba e-naslova imetnika: konec dogodka + 30 dni (vrednost ni nastavljiva; ista kot rok zetona).

# --- Guest lista (migracija 035, index.js »GUEST LISTA«, invarianta I24) ---
# Najvec vrstic povabljencev na eni listi, STETIH TUDI ODSTRANJENE (vsako vabilo naredi vstopnico, odstranitev jo razveljavi: meja ustavi neskoncno
# dodajanje/odstranjevanje, ki bi napihovalo tickets). Privzeto 60 (= trikrat najvec 20 mest); nad mejo vabilo vrne 409, admin lahko listo preklice in izda novo.
# Omejevalnik poti POST/DELETE /me/guest-lists/:id/invites je 30/h/IP (skupen kljuc »guest-lista«, v kodi, ne v okolju).
# GUEST_LISTA_VRSTIC_NAJVEC=60

# --- Potisna obvestila APNs (migracija 040, push_apns.js, invarianta I29, issue #183) ---
# Push je IZKLOPLJEN, dokler niso nastavljene vse tri spremenljivke APNS_KEY_ID, APNS_TEAM_ID in APNS_KEY_P8 (ena vrstica v dnevniku ob zagonu); vse ostalo dela.
# Vrednosti so SAMO na Renderju (Environment), nikoli v repu ali dnevniku. Apple: Keys -> APNs .p8 kljuc (Sandbox & Production).
# APNS_KEY_ID: 10-mestni ID kljuca (glava »kid« v JWT). APNS_TEAM_ID: 10-mestni Team ID (»iss« v JWT).
# APNS_KEY_P8: BASE64 CELE .p8 datoteke (npr. `base64 -w0 AuthKey_XXXX.p8`); sprejme se tudi surov PEM (-----BEGIN PRIVATE KEY-----).
# Preklic ali zamenjava kljuca: nov .p8 -> nov APNS_KEY_ID + APNS_KEY_P8 na Renderju, redeploy; do takrat APNs odgovarja 403 InvalidProviderToken
# (v dnevniku ena vrstica na minuto »[push] APNs: status 403 ...«), zetoni naprav ostanejo veljavni.
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_KEY_P8=
# Neobvezno: gostitelj APNs (privzeto https://api.push.apple.com; testi ga preusmerijo na lazni HTTP/2 streznik), bundle ID (privzeto si.outly.app),
# rok enega zahtevka v ms (privzeto 10000), najvec hkratnih zahtevkov v procesu (privzeto 20; sledilci kluba so lahko tisoci, pošilja se po serijah),
# najvec cakajocih obvestil (privzeto 20000; nad mejo se obvestila zavrzejo, zvonec ostane).
# Samo produkcijsko okolje APNs (TestFlight ga uporablja); Xcode Debug (sandbox) ni podprt.
# APNS_HOST=https://api.push.apple.com
# APNS_TOPIC=si.outly.app
# APNS_TIMEOUT_MS=10000
# APNS_SOCASNO=20
# APNS_VRSTA_NAJVEC=20000
# Samo za teste: lazni APNs ima samopodpisan certifikat; backend mu zaupa prek NODE_EXTRA_CA_CERTS (nastavitev procesa Node, ne kode).
