# =============================================================================
# Outly backend — okoljske spremenljivke
# =============================================================================
# Skopiraj v .env in izpolni. Prave vrednosti so na Renderju pod
# outly-backend → Environment. .env NIKOLI ne sme v git.
# =============================================================================

# --- Podatkovna baza ---------------------------------------------------------
# Povezovalni niz PostgreSQL. Koda vklopi SSL za vse, kar ni localhost.
DATABASE_URL=postgres://uporabnik:geslo@gostitelj:5432/outly

# --- Avtentikacija -----------------------------------------------------------
# Od 11. 9. 2026 backend lastnih žetonov NE izdaja več (Supabase Auth spodaj).
# JWT_SECRET ostane samo kot rezervna skrivnost za podpis QR kod vstopnic
# (če QR_SECRET ni nastavljen). Ob zamenjavi se razveljavijo vse QR kode.
JWT_SECRET=
QR_SECRET=

# --- Supabase Auth (migracija 010) --------------------------------------------
# Edina identiteta aplikacije in spletne strani. Backend Supabasov JWT (ES256)
# preveri z javnim ključem z /auth/v1/.well-known/jwks.json — skrivnosti ni.
# Obe vrednosti sta JAVNI (isti kot v supabase-config.js na outly.si) in imata
# v kodi privzete vrednosti; nastavi ju le, če se projekt zamenja.
# service_role ključa backend NE potrebuje in ga tu NE sme biti.
SUPABASE_URL=https://zbewqcxnvrwebxonvebx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_NzgXZhG7RGs0mZMjGYtyig_XfOvepXS

# --- E-pošta (Resend) --------------------------------------------------------
# POZOR: backend aplikacije uporablja Resend, ne Brevo. Brevo pokriva
# izključno waitlist na spletni strani. To sta dva ločena ponudnika.
RESEND_API_KEY=
EMAIL_FROM=Outly <luka@outly.si>
APP_NAME=Outly

# --- Slike (Cloudinary) ------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=outly

# --- Strežnik ----------------------------------------------------------------
# Render to nastavi sam. Lokalno pusti 3000.
PORT=3000
