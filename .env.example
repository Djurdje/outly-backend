# ===============================================================
# Outly backend — okoljske spremenljivke
# ===============================================================
# Skopiraj v .env in izpolni. Prave vrednosti so na Renderju pod
# outly-backend → Environment. .env NIKOLI ne sme v git.
# ===============================================================

# --- Podatkovna baza ---------------------------------------------------------
# Povezovalni niz PostgreSQL. Koda vklopi SSL za vse, kar ni localhost.
DATABASE_URL=postgres://uporabnik:geslo@gostitelj:5432/outly

# --- Avtentikacija -----------------------------------------------------------
# Od 11. 9. 2026 backend lastnih žetonov NE izdaja več (Supabase Auth spodaj).
# JWT_SECRET ostane samo kot rezervna skrivnost za podpis QR kod vstopnic
# (če QR_SECRET ni nastavljen). Iz nje je izpeljan tudi Ed25519 par za QR v2 (HKDF) — nove spremenljivke ni.
# Ob zamenjavi se razveljavijo vse QR kode.
JWT_SECRET=
QR_SECRET=

# --- Supabase Auth (migracija 010) --------------------------------------------
# Edina identiteta aplikacije in spletne strani. Backend Supabasov JWT (ES256)
# preveri z javnim ključem z /auth/v1/.well-known/jwks.json — skrivnosti ni.
# Obe vrednosti sta JAVNI (isti kot v supabase-config.js na outly.si) in imata
# v kodi privzete vrednosti; nastavi ju le, če se projekt zamenja.
# service_role ključa backend NE potrebuje in ga tu NE sme biti.
SUPABASE_URL=https://zbewqcxnvrwebxonvebx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_NzgXZhG7RGs0mZMjGYtyig_XfOvepXS

# --- E-pošta (Resend) --------------------------------------------------------
# POZOR: backend aplikacije uporablja Resend, ne Brevo. Brevo pokriva
# izključno waitlist na spletni strani. To sta dva ločena ponudnika.
RESEND_API_KEY=
EMAIL_FROM=Outly <luka@outly.si>
APP_NAME=Outly
# Kam gre obvestilo o novi prošnji ustvarjalca (več naslovov z vejico).
TEAM_EMAIL=luka@outly.si,fedja@outly.si
# Kam gre mail ob novi PRIJAVI ZLORABE (POST /reports, migracija 041; Apple App Review 1.2). Naslovi z vejico.
# Prazno ali ni nastavljeno = brez maila (prijave so vseeno v admin panelu, zavihek Reports). Mail vsebuje id, vrsto in ime cilja, razlog in
# uporabnisko ime prijavitelja (ne e-naslova, ne prostega besedila prijave). Najvec PRIJAVE_MAIL_NA_URO (privzeto 10) mailov na uro na proces.
# Neobvezno: PRIJAVE_NA_DAN (50, najvec prijav enega uporabnika v 24 h), BLOKI_NAJVEC (500, blokov na uporabnika).
ADMIN_PRIJAVE_EMAIL=

# --- Slike (Cloudinary) ------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=outly
# Največ podpisov za nalaganje (POST /uploads/cloudinary-signature) na UPORABNIKA na uro (privzeto 60). En podpis = eno nalaganje.
PODPIS_CLOUDINARY_NA_URO=

# --- Strežnik ----------------------------------------------------------------
# Render to nastavi sam. Lokalno pusti 3000.
PORT=3000

# --- Izvoz baze (GET /admin/api/export) ----------------------------------------
# Neobvezno; privzeti vrednosti sta v redu. Bralec, ki ne bere dlje kot DRAIN, je odklopljen; mirujoča transakcija
# izvoza se po IDLE_TX sama prekine (migracija ob deployu ne sme čakati za izvozom). DRAIN naj bo krajši od IDLE_TX.
EXPORT_DRAIN_TIMEOUT_MS=60000
EXPORT_IDLE_TX_MS=120000

# --- Omejevalnik poskusov (omeji() v index.js, tabela omejitve) -----------------
# Neobvezno; privzeti vrednosti sta v redu. Omejevalnik ima lasten majhen pool povezav (ne zaseda glavnega poola).
# Kljuci v bazi so HMAC(pot:meja:okno:IP), izpeljan iz QR_SECRET/JWT_SECRET (nove skrivnosti ni; zamenjava skrivnosti enkrat ponastavi meje).
# Najvec povezav omejevalnika na instanco (privzeto 2). Skupaj z glavnim poolom (10) in drugimi pooli to steje proti max_connections
# Renderjeve baze 256 MB (ob prekrivanju deploya stara + nova instanca = dvojno), zato ne dvigaj brez potrebe.
# OMEJEVALNIK_POOL_MAX=2
# Kako pogosto proces pobrise iztekle vrstice (ms). Samo za teste: krajse vrednosti.
# OMEJEVALNIK_CISCENJE_MS=120000
# Pospravljanje rezervacij mize po telefonu (migracija 032): kako pogosto (ms, privzeto 3600000 = 1 h; 0 = izklop) proces pobrise
# rezervacije dogodkov, ki so se koncali pred vec kot 24 h (ime gosta je osebni podatek). Samo za teste: krajse vrednosti.
# Prvi tek je 5 min (ali interval, ce je krajsi) + nakljucnih do 60 s po zagonu.
# REZERVACIJE_CISCENJE_MS=3600000

# --- Migracije (db/migrate.js, teče ob vsakem deployu; issue #115) ---------------
# Neobvezno; privzete vrednosti so v redu. Migracija, ki v LOCK_TIMEOUT ne dobi zaklepa tabele, se vrne nazaj in poskusi
# še PONOVITVE-krat po PREMOR; če zaklepa ni, deploy pade (Render obdrži staro različico) namesto da ustavi branja in skene.
# STATEMENT_TIMEOUT velja na stavek. KLJUCAVNICA_TIMEOUT = čakanje na migracijski advisory lock druge seje.
# Kratka meja je namenoma: čakajoči ALTER blokira nove poizvedbe po tabeli (tudi sken vstopnic).
# Čas: ms ali število s priponko ms|s|min; 0 = brez meje. Dvigni samo za en deploy in samo z razlogom.
MIGRACIJA_LOCK_TIMEOUT=2s
MIGRACIJA_STATEMENT_TIMEOUT=120s
MIGRACIJA_KLJUCAVNICA_TIMEOUT=60s
MIGRACIJA_PONOVITVE=4
MIGRACIJA_PREMOR=10s

# --- Javni predpomnilnik (GET /events, /clubs, /events/:id, /clubs/:id; issue #114) -----------------------------
# Neobvezno; privzeti vrednosti sta v redu. TTL v ms (0 = izklopljeno; najvec 60000), najvec kljucev (LRU).
# Zapis v tem procesu predpomnilnik izprazni takoj; druge instance in neposredne spremembe baze zaostanejo najvec TTL.
JAVNI_PREDPOMNILNIK_MS=3000
JAVNI_PREDPOMNILNIK_KLJUCEV=300
# Casovna meja (ms) cakanja na poizvedbo, ki jo je zacel drug zahtevek za isti kljuc; obviselo poizvedbo kljuc spusti.
JAVNI_PREDPOMNILNIK_CAKANJE_MS=8000

# --- Zmogljivost / obremenitev (issue #89; vse neobvezno, privzetki so varni) ---
# Velikost glavnega poola povezav z bazo (privzeto 10) in ločenega poola SAMO za sken vstopnic (privzeto 3).
# Skupaj ne presezi max_connections baze (Render 0,1 CPU / 256 MB: preveri pred dvigom).
# Povezav na instanco: glavni pool (10) + sken (3) + omejevalnik (2) + zdravje (1, FIKSNO, brez nastavitve) = 16;
# ob prekrivanju deploya (stara + nova instanca) do 32, plus 1 povezava migrate.js ob deployu = do 33. max_connections
# Renderjeve baze 256 MB v repu NI preverjen (preveri na Renderju pred dvigom ali novim poolom).
# `zdraviPool` je lasten pool SAMO za GET /healthz (issue #117): ob navali nakupov glavni pool ni na voljo, Render pa ne sme
# dobiti 503 in instance ponovno zagnati.
# Kdaj je pool vseeno nezdrav: /healthz vrne 503 (in Render instanco ponovno zazene) samo ob ZASTOJU glavnega poola ali skenPool:
# vse povezave izposojene IN nobena se ni vrnila dlje od tega (ms; privzeto 60000, meje 100..3600000). Preobremenitev, ob kateri
# pool krozi (povezave se vracajo), tega NE sprozi, tudi ce vrsta cakajocih ni nikoli prazna; puscanje povezav in obvisele
# transakcije ga sprozijo.
ZDRAVJE_ZASICEN_MS=
PG_POOL_MAX=
PG_SKEN_POOL_MAX=
# Koliko ms zahtevek čaka na prosto povezavo, preden odpove (privzeto 10000); za sken je rok krajši (privzeto 2500),
# da telefon ob 503 hitro preklopi na preverjanje brez povezave.
PG_CONNECT_TIMEOUT_MS=
PG_SKEN_CONNECT_TIMEOUT_MS=
# Časovne meje stavkov na povezavah skena (skenPool), v ms. Migracija ob deployu (drži zaklep tabele do
# MIGRACIJA_STATEMENT_TIMEOUT) ali dolga transakcija, ki drži vrstico vstopnice, bi sken sicer zadržala do konca zaklepa.
# LOCK = najdlje čakanje na zaklep (privzeto 1000): to je glavna meja - med migracijo sken v ~1 s dobi 503 Retry-After
# in telefon preklopi na sken brez povezave.
# STATEMENT = najdlje trajanje enega stavka (privzeto 5000), samo varovalo proti obviselemu stavku. NE nižaj pod roke odjemalcev
# (iOS: hitra pot scan-batch 2 s, POST /business/tickets/scan 4 s, odjava 5 s) in ne pod hladen čas stavka na počasni bazi.
# SEZNAM = meja za en velik stavek scan-list in branje paketa scan-batch (privzeto 10000, nikoli nižja od STATEMENT;
# splet čaka scan-list 20 s, iOS 30 s): na Renderjevi bazi (0,1 CPU, hladen predpomnilnik po deployu) traja dogodek
# z ~20 000 vstopnicami lahko nekaj sekund. 0 = brez meje (velja nastavitev baze).
# Vse povezave z bazo tečejo z jit=off (#265; JIT je scan-list velikega dogodka podaljšal za sekunde; ni nastavitev). Pooler
# (PgBouncer), ki zavrne zagonski parameter options, jih podre - /healthz je tedaj 503 (Render deploy zavrne).
PG_SKEN_LOCK_TIMEOUT_MS=
PG_SKEN_STATEMENT_TIMEOUT_MS=
PG_SKEN_SEZNAM_STATEMENT_TIMEOUT_MS=
# Odjemalski rok poizvedbe skenPool (ms, privzeto 12000; vedno vsaj največja meja zgoraj + 2000; 0 = izklop): povezava, ki visi
# na polodprtem TCP (baza je ne zapre), se po roku zavrže in sken dobi 503 namesto visenja. POZOR: ob PG_SKEN_STATEMENT_TIMEOUT_MS=0
# (in SEZNAM=0) ostane ta rok (privzeto 12 s) EDINA meja poizvedbe skena; ob 0 tu in zgoraj sken nima nobene meje.
PG_SKEN_QUERY_TIMEOUT_MS=
# Seja skenPool, ki v bazi ostane `idle in transaction` (odjemalec jo je zavrgel po query_timeout, baza tega ne ve), se zapre po
# tem roku (ms, privzeto 15000; 0 = izklop). Sicer drži zaklep na tickets/orders in naslednja migracija ob deployu obvisi.
PG_SKEN_IDLE_TX_TIMEOUT_MS=
# scan-batch: ko je element paketa že padel na zasedeni bazi (zaklep) in paket teče dlje od tega (ms, privzeto 5000),
# ostali elementi dobijo "error" brez poskusa (telefon jih pošlje znova). Paket brez napak tega roka nima.
# 0 = rok izklopljen (vsak element se poskusi, tudi če paket zaradi zaklepov traja n x LOCK).
SKEN_BATCH_ROK_MS=
# Največ hkratnih nakupnih transakcij (privzeto 4); ostali nakupi čakajo v pomnilniku največ NAKUP_CAKANJE_MS
# (privzeto 15000), nato dobijo 503 Retry-After. NAKUP_DB_TIMEOUT_MS = lock_timeout in statement_timeout nakupne
# transakcije (privzeto 10000). NAKUP_RAZPRODANO_MS = kako dolgo se razprodan dogodek zavrača brez baze (privzeto 3000, 0 = izklop).
NAKUP_VZPOREDNO=
NAKUP_CAKANJE_MS=
NAKUP_DB_TIMEOUT_MS=
NAKUP_RAZPRODANO_MS=
# Klic Stripa po COMMIT-u (#274) ne drzi dovoljenja nakupa ne povezave z bazo; ima lasten semafor: STRIPE_VZPOREDNO = hkratni klici
# ustvarjanja Checkout seje (privzeto 24), STRIPE_CAKANJE_MS = najdlje cakanje na prosto mesto (privzeto 20000), nato 503 Retry-After + narocilo failed.
STRIPE_VZPOREDNO=
STRIPE_CAKANJE_MS=
# Idempotentni kljuc nakupa (glava Idempotency-Key, #112): kako dolgo (ms, privzeto 10000) ponovitev, katere prvotni zahtevek
# je se v teku v istem procesu, caka na njegov rezultat; potem 409 request_in_progress + Retry-After 2. 0 = takoj 409.
IDEMPOTENCA_CAKANJE_MS=

# Dnevnik povezav (issue #139): enkrat na toliko ms vrstica `[povezave] 60 s: novih N, zahtevkov M, odprtih K, zamik zanke p99 X ms, max Y ms`
# (nove povezave, zahtevki, odprte povezave in zamik zanke dogodkov v oknu; brez IP-jev in osebnih podatkov). Okno brez prometa
# ne izpise nicesar. Privzeto 60000, najmanj 100, 0 = izklop. V Render logih: iskanje `[povezave]`.
DNEVNIK_POVEZAV_MS=
# Kako dolgo (ms) Node drzi mirujoco vzdrzevano (keep-alive) povezavo odprto (#139, korak 2). Privzeto 120000 (Render za Node
# priporoca vrednost nad mirovalnim rokom proxyja, vir: https://render.com/docs/troubleshooting-deploys, »502 Bad Gateway«; Node sam ima 5000, zato je proxy zadel zaprte povezave). headersTimeout se
# nastavi samodejno na toliko + 1000 ms. Najvec 280000 (requestTimeout je 300 s); neveljavno ali 0 = privzeto.
KEEPALIVE_MS=

# --- Placila: Stripe Checkout + Connect Express (issue #19, placila_stripe.js) ---
# Brez STRIPE_SECRET_KEY deluje testni nacin (narocilo takoj placano, oznaka test_, nic zaracunano).
# sk_test_... = Stripe SANDBOX: klubi z dokoncanim Connect onboardingom placujejo prek Stripa (testne kartice),
#               klubi brez Stripa se vedno v testnem nacinu (demo klubi, TestFlight).
# sk_live_... = pravi denar: klub brez dokoncanega onboardinga ne prodaja (409).
# Vrednosti nastavi Martin na Renderju; agent jih ne sprejema.
STRIPE_SECRET_KEY=
# Podpis webhooka /stripe/webhook (whsec_...). Brez njega Stripe nakupi vracajo 503.
STRIPE_WEBHOOK_SECRET=
# Neobvezno: drugi endpoint za dogodke povezanih racunov (account.updated), ce je v Stripu nastavljen loceno.
STRIPE_CONNECT_WEBHOOK_SECRET=
# Kam Stripe vrne kupca in klub (privzeto https://outly.si).
APP_URL=https://outly.si
# Provizija Outlyja v odstotkih (privzeto 10).
PROVIZIJA_ODSTOTEK=10
# Samo za lokalne teste: TEST_PLACILA=true vsili testni nacin; STRIPE_API_BASE preusmeri Stripe na lazni streznik.
# POZOR: TEST_PLACILA=true se ob zivem kljucu (sk_live_) IGNORIRA (zagon izpise »[placila] POZOR ...«); na Renderju ga ne nastavljaj (#191).
# Potrdilo o nakupu kupcu z racunom (migracija 042, #95) uporablja iste nastavitve pospravljalca/rokov kot gostov mail (GOST_POSTA_*).
# Najvec potrdil na uporabnika na 24 h za narocila BREZ placila (testni nacin, 0 EUR); placana potrdila se nikoli ne omejijo (privzeto 20).
# POTRDILO_BREZ_PLACILA_NA_DAN=20
# Preverjanje potekle Stripove seje (#149): razmik med klici Stripa za isto narocilo (privzeto 5000 ms) in najdaljse cakanje klicatelja (privzeto 4000 ms). Samo za teste.
# PREVERI_OKNO_MS=5000
# PREVERI_ODLOG_MS=120000   # odlog preverjanja potekle seje po roku (3DS)
# Najvec brezplacnih (0 EUR) vstopnic na osebo (uporabnik ali normaliziran e-naslov gosta) in dogodek; presezek 409 free_limit (privzeto 10).
# ZASTONJ_NA_OSEBO=10
# PREVERI_ROK_MS=4000

# --- Nakup brez racuna / gost (migracija 033, index.js »NAKUP BREZ RACUNA«) ----------------------------------
# Neobvezno; privzete vrednosti so v redu.
# Nakupov gostov na IP na uro (privzeto 10), vstopnic na gostujoce narocilo (privzeto 6).
# GOST_NAKUP_NA_URO=10
# GOST_QUANTITY_NAJVEC=6
# Nakup brez racuna je privzeto IZKLOPLJEN v VSEH nacinih (503 »Guest checkout is not available yet.«, #249). Velja samo za nakup; ogled, preklic in
# prevzem obstojecih gostujocih narocil delajo vedno. Spremenljivki se ne prekrivata:
# - zivi kljuc (sk_live_): GOST_NAKUP_LIVE=1, vklopi Martin po objavi pogojev/politike zasebnosti;
# - sandbox (sk_test_), testni nacin (TEST_PLACILA) ali brez kljuca: GOST_NAKUP_TEST=1, samo ce ekipa testira gosta (brez tega nihce prek javne poti
#   ne dobi brezplacnih veljavnih vstopnic s sandbox kartico).
# GOST_NAKUP_LIVE=
# GOST_NAKUP_TEST=
# Skupna meja cakajocih (neplacanih) gostujocih vstopnic na dogodek: max(NAJMANJ, ODSTOTEK % kapacitete).
# GOST_CAKAJOCIH_NAJMANJ=10
# GOST_CAKAJOCIH_ODSTOTEK=20
# Neuspesni ogledi/preklici zetona na IP na uro (privzeto 60) in iskanja po Idempotency-Key na IP na uro (privzeto 300); stevca v pomnilniku procesa.
# GOST_NEUSPESNI_NA_URO=60
# GOST_IDEM_ISKANJ_NA_URO=300
# Mail z vstopnico: globalna dnevna meja (privzeto 300), rok za klic Resenda (ms, privzeto 10000).
# GOST_POSTA_DNEVNO=300
# Mail gostu za 0 EUR (brez placila in potrditve naslova): globalna dnevna meja (privzeto 300); poleg tega najvec 3 na normaliziran naslov na 24 h (fiksno). Nad mejo se mail izpusti.
# GOST_POSTA_ZASTONJ_DNEVNO=300
# GOST_POSTA_TIMEOUT_MS=10000
# Koliko dni po koncu dogodka se e-naslov PLACANEGA gostujocega narocila anonimizira (privzeto 180; PREDPOSTAVKA, odloci Martin).
# Neplacano/preklicano se anonimizira po 24 h. Cistilec tece po urniku rezervacij (REZERVACIJE_CISCENJE_MS).
# GOST_HRAMBA_DNI=180
# Pospravljalec mailov z vstopnico (ms, privzeto 120000; 0 = izklop) in premor po 1. neuspelem poskusu (ms; naslednji so mnogokratniki: 2 min, 5 min, 15 min, 1 h, 3 h, 12 h, 24 h).
# GOST_POSTA_PONOVI_MS=120000
# GOST_POSTA_PREMOR_MS=120000
# GOST_POSTA_REZERVA_MS=30000   # spodnja meja premora ponovnega prevzema = GOST_POSTA_TIMEOUT_MS + to (priprava maila: QR, PDF)
# Kako pogosto /me/orders in /me/tickets znova iscejo gostujoca narocila za prevzem v racun (ms, privzeto 30000; GET /me vedno). Samo za teste: 0.
# GOST_PREVZEM_MS=30000
# Samo za teste: RESEND_BASE_URL preusmeri Resend SDK na lazni streznik.


# --- Prenos vstopnice prijatelju BREZ racuna (migracija 034, index.js »PRENOS VSTOPNICE PRIJATELJU BREZ RACUNA«) ---
# Stikalo: PRENOS_BREZ_RACUNA=vsi vklopi za VSE uporabnike; privzeto (prazno) samo vloga admin (ekipa testira v produkciji).
# Vklopi Martin na Renderju po objavi pogojev 1.2 in politike zasebnosti 2.5 (pravna presoja outly-hq pravno/2026-10-05-prenos-brez-racuna.md).
# Stikalo velja samo za posiljanje GOSTU; potrditev starosti posiljatelja (age_confirmed) pri prenosu na racun ni vezana nanj.
# PRENOS_BREZ_RACUNA=
# Meje zlorabe (mail tujemu naslovu): prenosov gostu na posiljatelja na 24 h (privzeto 10) in na isti prejemnikov e-naslov na 24 h (privzeto 10).
# Prenosi z allow_guest na posiljatelja in na (normaliziran: brez +oznake, pike pri gmail) naslov na 24 h; globalna dnevna meja prenosov gostu (ob dosegu 429 + alarm v dnevniku).
# GOST_PRENOS_NA_DAN=10
# GOST_PRENOS_NA_NASLOV=10
# GOST_PRENOS_DNEVNO=500
# Mail prejemniku uporablja iste nastavitve pospravljalca in rokov kot potrdilo gostujocega nakupa (GOST_POSTA_PONOVI_MS, GOST_POSTA_PREMOR_MS, GOST_POSTA_TIMEOUT_MS);
# hramba e-naslova imetnika: konec dogodka + 30 dni (vrednost ni nastavljiva; ista kot rok zetona).

# --- Guest lista (migracija 035, index.js »GUEST LISTA«, invarianta I24) ---
# Najvec vrstic povabljencev na eni listi, STETIH TUDI ODSTRANJENE (vsako vabilo naredi vstopnico, odstranitev jo razveljavi: meja ustavi neskoncno
# dodajanje/odstranjevanje, ki bi napihovalo tickets). Privzeto 60 (= trikrat najvec 20 mest); nad mejo vabilo vrne 409, admin lahko listo preklice in izda novo.
# Omejevalnik poti POST/DELETE /me/guest-lists/:id/invites je 30/h/IP (skupen kljuc »guest-lista«, v kodi, ne v okolju).
# GUEST_LISTA_VRSTIC_NAJVEC=60

# --- Potisna obvestila APNs (migracija 040, push_apns.js, invarianta I29, issue #183) ---
# Push je IZKLOPLJEN, dokler niso nastavljene vse tri spremenljivke APNS_KEY_ID, APNS_TEAM_ID in APNS_KEY_P8 (ena vrstica v dnevniku ob zagonu); vse ostalo dela.
# Vrednosti so SAMO na Renderju (Environment), nikoli v repu ali dnevniku. Apple: Keys -> APNs .p8 kljuc (Sandbox & Production).
# APNS_KEY_ID: 10-mestni ID kljuca (glava »kid« v JWT). APNS_TEAM_ID: 10-mestni Team ID (»iss« v JWT).
# APNS_KEY_P8: BASE64 CELE .p8 datoteke (npr. `base64 -w0 AuthKey_XXXX.p8`); sprejme se tudi surov PEM (-----BEGIN PRIVATE KEY-----).
# Preklic ali zamenjava kljuca: nov .p8 -> nov APNS_KEY_ID + APNS_KEY_P8 na Renderju, redeploy; do takrat APNs odgovarja 403 InvalidProviderToken
# (v dnevniku ena vrstica na minuto »[push] APNs: status 403 ...«), zetoni naprav ostanejo veljavni.
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_KEY_P8=
# Neobvezno: gostitelj APNs (privzeto https://api.push.apple.com; testi ga preusmerijo na lazni HTTP/2 streznik), bundle ID (privzeto si.outly.app),
# rok enega zahtevka v ms (privzeto 10000), najvec hkratnih zahtevkov v procesu (privzeto 20; sledilci kluba so lahko tisoci, pošilja se po serijah),
# najvec cakajocih obvestil (privzeto 20000; nad mejo se obvestila zavrzejo, zvonec ostane).
# Samo produkcijsko okolje APNs (TestFlight ga uporablja); Xcode Debug (sandbox) ni podprt.
# APNS_HOST=https://api.push.apple.com
# APNS_TOPIC=si.outly.app
# APNS_TIMEOUT_MS=10000
# APNS_SOCASNO=20
# APNS_VRSTA_NAJVEC=20000
# Prednostna vrsta (#277 N3, I47): operativni pushi (strezba VIP mize natakarju, prejeta vstopnica, vabilo na guest listo) imajo prednost pred mnozicnimi (objava dogodka sledilcem).
# APNS_REZERVA = koliko od APNS_SOCASNO slotov je samo za operativne (privzeto 2, najvec SOCASNO - 1; mnozicna obvestila zasedejo najvec SOCASNO - REZERVA, tudi ko operativnih ni:
# prepustnost mnozicnih je pri 2 od 20 ~10 % nizja; 0 = brez rezerve). APNS_OPERATIVNIH_ZAPORED = po koliko zaporednih operativnih dodelitvah ob cakajocih mnozicnih gre ena mnozicna
# (privzeto 8; mnozicna ne stradajo). Neveljavna vrednost (ni celo stevilo ali izven obmocja 0..100 oz. 1..1000) = privzeta.
# APNS_REZERVA=2
# APNS_OPERATIVNIH_ZAPORED=8
# Samo za teste: lazni APNs ima samopodpisan certifikat; backend mu zaupa prek NODE_EXTRA_CA_CERTS (nastavitev procesa Node, ne kode).

# --- Sentry (issue #87, sentry.js; brezplacni paket: 5.000 napak/mesec skupaj za vse projekte, presezek se zavrze, ne zaracuna) ---
# SENTRY_DSN: naslov projekta v Sentryju (org `outly-hd`, regija DE, projekt `outly-backend`; Sentry -> Settings -> Projects -> outly-backend -> Client Keys (DSN)).
# Vpise ga SAMO Martin na Renderju (Environment), nikoli v repo. BREZ SENTRY_DSN je Sentry povsem izklopljen: paket @sentry/node se sploh ne naloži,
# testi in lokalni zagon so enaki kot prej. Ob vklopu se poslje: neujete izjeme, unhandledRejection, vsak odgovor 500 (sklad + vzorec poti, npr.
# `GET /events/:id`) in vrstice »POZOR« iz dnevnika. NE poslje se: glave, telo, piskotki, query, URL, IP, uporabnik, e-naslovi, zetoni. Brez sledenja
# zmogljivosti (performance) in brez OpenTelemetry. environment = production, ce je nastavljen RENDER; release = RENDER_GIT_COMMIT (Render ga nastavi sam).
# Pogoj za vklop v produkciji: politika zasebnosti mora omenjati Sentry tudi za backend (Martinov DA).
# SENTRY_DSN=
# Najvec dogodkov na uro iz tega procesa (privzeto 30; neujete izjeme/zavrnitve gredo vedno skozi); isti kljuc najvec enkrat na 15 min (v kodi).
# SENTRY_NAJVEC_NA_URO=30

# --- Vracila (issue #190, vracila_stripe.js, I37). Vse neobvezno; privzete vrednosti so za produkcijo, spremenljivke so v glavnem za teste. ---
# Obdelovalec vracil po odpovedi dogodka tece v ozadju (ne v zahtevku). Odpoved dogodka samo vstavi vrstice v `vracila`.
# VRACILA_TICK_MS=10000       kako pogosto tece obdelovalec (0 = izklopljen)
# VRACILA_RAZMAK_MS=250       premor med dvema narocilama (omejitev hitrosti proti Stripu: ~4 vracila/s)
# VRACILA_PAKET=20            koliko vrstic prevzame naenkrat
# VRACILA_POSKUSOV=8          najvec poskusov na vracilo (prehodne napake), nato `ni_uspelo` + `[vracila] POZOR`
# VRACILA_PREMOR_MS=0         stalen premor med poskusi (0 = narascajoc: 30 s, 2 min, 10 min, 30 min, 2 h, 6 h, 12 h)
# VRACILA_ZAMIK_S=60          odlog zacetka vracil po odpovedi (lastnik, ki dogodek obnovi, ustavi vracilo)
# VRACILA_SWEEP_MS=60000      kako pogosto sweep dodaja vracila za dogodke, odpovedane po drugi poti kot DELETE
# VRACILA_MAIL_RAZMAK_MS=550  razmik med obvestili kupcem (Resend ~2 zahtevka/s)
# VRACILA_POTRDITEV_MS=3600000  kako pogosto obdelovalec sprasuje Stripe po vracilih v stanju `potrditev` (Stripe pending)
# VRACILA_NI_IZVEDENO_PO_MS=3600000  (1 h) koliko casa po Stripovi zavrnitvi vracila (stripe_stanje failed/canceled, vrstica `ni_uspelo`/`rocno`) kupec dobi
#                             mail »vracilo se ni izvedeno, uredili ga bomo rocno« (#251). Samo blazilnik: zavrnjenega vracila admin ne more ponoviti (retry 409).
#                             Pri odpovedi dogodka gre sele po mailu »dogodek odpovedan«. Brez znanega Stripovega izida (napaka API, sesutje) maila NI, samo alarm.

# --- Davcno potrjeni racuni lastnih dogodkov Outly (ZDavPR; racuni.js, migracija 054, ARCHITECTURE I52). Vse neobvezno. ---
# Kdo potrdi racun (EOR), se ni izbrano (e-racuni.com, Space Invoices ali lastna povezava s FURS). Do takrat:
# RACUNI_PONUDNIK=            prazno ali `izklopljen` (PRIVZETO, tudi v produkciji): placano narocilo uradnega profila (I50) dobi vrstico `caka` v `racuni`
#                             (dolg racuna, brez stevilke), vracilo dobi dobropis `caka`; delavec ne tece, nic se ne poslje, zagon ne pade.
#                             `lazni` = samo testi (v produkciji, RENDER/NODE_ENV=production, zavrnjen: izklopljen + POZOR). Neznano ime = izklopljen + POZOR.
# RACUNI_LAZNI_URL=           samo testi: HTTP naslov laznega ponudnika (brez njega lazni ponudnik vrne nakljucni EOR lokalno)
# RACUNI_PONUDNIK=eracuni     e-racuni.com PREMIUM (WS API; Martin 21. 10. 2026): e-racuni SAM dodeli davcno stevilko (po blagajni), davcno potrdi in vrne EOR/ZOI;
#                             nas stevec A001-1-N se pri tem ponudniku NE uporablja (merodajna je stevilka e-racuni, migracija 056). Brez katerega koli od prvih treh
#                             spodaj (ali ob neveljavni nastavitvi) je ponudnik IZKLOPLJEN + POZOR z imeni spremenljivk; zagon ne pade. Vrednosti vpise Martin NA RENDERJU,
#                             nikoli v repozitorij, dnevnik ali Sentry.
# ERACUNI_USERNAME=           uporabnik API (v e-racuni: uporabnik OUTLY)                                             [obvezno, skrivnost]
# ERACUNI_SECRET_KEY=         skrivni kljuc API uporabnika                                                            [obvezno, skrivnost]
# ERACUNI_TOKEN=              zeton organizacije (Nastavitve podjetja > spletne storitve)                             [obvezno, skrivnost]
# ERACUNI_POSLOVNA_ENOTA=A001 oznaka poslovne enote v e-racuni (businessUnit; mora biti prijavljena na FURS)
# ERACUNI_BLAGAJNA=1          oznaka davcne blagajne (cashRegisterCode = elektronska naprava)
# ERACUNI_URL=                privzeto https://e-racuni.com/WebServicesSI/API (mora biti https; samo izven produkcije tudi http://localhost)
# ERACUNI_NACIN_PLACILA=Stripe  methodOfPayment na dokumentu (dobropis lahko zahteva drugo vrednost - glej STATE)
# ERACUNI_VRSTA_PRODAJE=7     vatTransactionType postavk: 7 = »Neobdavcen promet - ne gre v DDV evidence« (NEXT DIMENSIONS ni zavezanec za DDV)
# ERACUNI_KUPEC=              neobvezna oznaka kupca na poenostavljenem racunu (NI ime osebe); privzeto brez kupca
# ERACUNI_RAZMAK_MS=1000      najmanj toliko med zacetkoma dveh zahtevkov (meja e-racuni: 1 zahtevek/s v povprecju, hip 4); socasnih zahtevkov ni (vedno 1 klic naenkrat)
# RACUNI_NEZNAN_PREMOR_MS=120000  izid klica neznan (rok, 5xx, omrezje): najmanj toliko do iskanja po referenci in nove izdaje (API nima idempotence)
# RACUNI_KONFIG_PREMOR_MS=600000  napacne poverilnice / blagajna / enota pri ponudniku: pocasna ponovitev + POZOR (vrstica ostane `caka`, ne `napaka`)
# RACUNI_LUKNJA_PO_MS=3600000 stevilka ponudnika manjka, naslednja je stara toliko -> `[racuni] POZOR` (luknja v zaporedju)
# ERACUNI_SEZNAM_PREVERJEN=   '1' SAMO ko je SalesInvoiceList preverjen z zivim klicem (glej STATE); sicer iskanje brez najdbe nikoli ne vodi v novo izdajo, ampak v `napaka` (rocno)
# RACUNI_PREIZKUS_ZAPORED=3    bralni preizkus pred izdajo (eracuni) pade toliko tekov zapored ...
# RACUNI_PREIZKUS_PO_MS=1800000  ... ALI dlje kot toliko -> POZOR (in Sentry opozorilo); racuni cakajo, zakonski rok sta 2 delovna dneva
# RACUNI_PREIZKUS_POZOR_RAZMAK_MS=3600000  isto opozorilo najvec enkrat na toliko
# ERACUNI_SEZNAM_MEJA=100     iskanje po referenci: seznam s toliko ali vec dokumenti je sumljiv (API morda krni) -> brez negativnega izida, nova izdaja blokirana (rocno)
# RACUNI_ISKANJE_RAZMAK_MS=600000  nova izdaja po nejasnem izidu sele po DVEH veljavnih iskanjih brez najdbe, med njima najmanj toliko (dokument je lahko viden z zamikom)
# RACUNI_ISKANJE_NEJASNO_MAX=4 toliko iskanj brez zanesljivega izida (neprepoznan, prazen ali okrnjen seznam) -> vrstica `napaka` z navodilom, NIKOLI nova izdaja
# RACUNI_PDF_POZOR_PO=5       PDF racuna iz e-racuni ni prejet (neveljaven odgovor, omrezje) toliko poskusov zapored -> `[racuni] POZOR` (mail kupcu NE gre brez PDF)
# RACUNI_PDF_NAJVEC_POSKUSOV=100  po toliko neuspehih zapored delavec PDF NEHA iskati (POZOR, rocna ponastavitev pdf_poskusi v STATE); najvec 9000
# RACUN_MAIL_RAZMAK_MS=550    najmanj toliko med dvema mailoma z racunom (Resend: 2 zahtevka/s na racun; semafor 1 hkrati)
# RACUN_MAIL_NEZNAN_ALARM_MS=600000  izid maila z racunom neznan (rok, ustavitev procesa) dlje kot toliko -> `[racun-kupcu] POZOR` (ponovitve NI, rocni pregled v Resendu)
# RACUNI_NAJEM_MS=90000        najem »en delavec e-racuni v celem sistemu« (API ne dovoli socasnih zahtevkov; ob deployu tecejo dve instanci); mora biti daljsi od roka klica
# Pri `eracuni` so privzeti RACUNI_VZPOREDNO=1 (zgornja meja), RACUNI_ROK_MS=30000 (klic vkljuci FURS), RACUNI_PAKET=5 in RACUNI_ZASTARELO_MS=300000.
# RACUNI_TICK_MS=2000         kako pogosto tece delavec (0 = ne tece); samo z izbranim ponudnikom
# RACUNI_VZPOREDNO=4          najvec hkratnih klicev ponudnika (lasten semafor, loceno od nakupov in Stripa)
# RACUNI_DB_VZPOREDNO=2       najvec hkratnih kratkih transakcij delavca (povezave glavnega poola, nikoli skenPool)
# RACUNI_ROK_MS=5000          rok enega klica ponudnika; po roku: racun ostane `izdan`, oznaka naknadno, ponovitev
# RACUNI_PAKET=50             koliko vrstic delavec prevzame naenkrat
# RACUNI_PREMOR_MS=0          stalen premor med ponovitvami (0 = narascajoc: 5 s, 30 s, 2 min, 10 min, 30 min, 1 h)
# RACUNI_ODLOG_MS=30000       dobropis caka, dokler izvirni racun nima stevilke oziroma ni potrjen
# RACUNI_ZASTARELO_MS=120000  prevzeta vrstica brez zakljucka (proces ugasnjen) se prevzame znova (isti message_id)
# RACUNI_POSPRAVI_MS=600000   pospravljalec: placano platformno narocilo brez racuna / vracilo brez dobropisa -> vpis + `[racuni] POZOR` (0 = izklop)
# RACUNI_POSPRAVI_ZAMIK_MS=300000  prvi tek pospravljalca po zagonu
# RACUNI_ALARM_PO_MS=86400000 racun ni potrjen toliko casa (ali je v stanju napaka) -> `[racuni] POZOR` (najvec 1x na 6 h); zakonski rok 2 delovna dneva
